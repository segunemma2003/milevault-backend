FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# -B runs the beat scheduler inside this (single) worker so the daily/5-minute jobs actually fire.
CMD ["sh", "-c", "celery -A app.services.celery_app worker -B --loglevel=info --concurrency=2 -Q default,media,notifications,kyc,payments --schedule /tmp/celerybeat-schedule"]
